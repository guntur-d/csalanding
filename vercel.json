{
    "version": 2,
    "rewrites": [
        {
            "source": "/dist/client/assets/(.*)",
            "destination": "/dist/client/assets/$1"
        },
        {
            "source": "/((?!api/|admin/|_moria/|dist/|styles\\.css|favicon\\.ico|.*\\.jpg|.*\\.png|.*\\.pdf).*)$",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.ts": {
            "includeFiles": "src/routes/**"
        }
    }
}