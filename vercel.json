{
    "version": 2,
    "rewrites": [
        {
            "source": "/assets/(.*)",
            "destination": "/api"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/((?!api/|admin/|_moria/|assets/|styles\\.css|.*\\.jpg|.*\\.png|.*\\.pdf).*)$",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.ts": {
            "includeFiles": "{dist,public,src,package.json}/**",
            "maxDuration": 60
        }
    }
}