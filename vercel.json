{
    "version": 2,
    "rewrites": [
        {
            "source": "/((?!serverless/|moria/|_moria/).*)",
            "destination": "/serverless/index"
        }
    ],
    "functions": {
        "serverless/index.ts": {
            "includeFiles": "{dist,public,src,package.json}/**",
            "maxDuration": 60
        }
    }
}