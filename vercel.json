{
    "version": 2,
    "rewrites": [
        {
            "source": "/((?!api/|moria/|_moria/).*)",
            "destination": "/api/index"
        }
    ],
    "functions": {
        "api/index.ts": {
            "includeFiles": "{dist,public,src,package.json}/**",
            "maxDuration": 60
        }
    }
}